{
  "name": "slimevr-firmware-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint {src,apps,libs,test}/**/*.{ts,tsx}",
    "lint:fix": "eslint --fix \"{src,apps,libs,test}/**/*.{js,jsx,ts,tsx,json}\" && pnpm run format",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "adm-zip": "^0.6.1",
    "aws-sdk-v3-nest": "^0.3.0",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "glob": "^13.0.6",
    "node-fetch": "^2.7.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.1.14",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "semver": "^7.8.5",
    "superagent": "^10.4.1",
    "swagger-ui-express": "^4.6.3",
    "typeorm": "^0.3.31",
    "universal-base64url": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/adm-zip": "^0.6.0",
    "@types/cache-manager": "^3.4.3",
    "@types/express": "^4.17.25",
    "@types/jest": "27.4.1",
    "@types/node": "^20.19.43",
    "@types/node-fetch": "^2.6.13",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "jest": "^30.5.2",
    "prettier": "^2.8.8",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^3.15.0",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ],
    "overrides": {
      "multer": ">=2.5.0",
      "js-yaml@>=5.0.0 <5.4.1": ">=5.4.1"
    }
  }
}
